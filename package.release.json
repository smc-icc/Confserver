    "express": "^4.17.1",
    "fs-extra": "^5.0.0",
    "hashring": "^3.2.0",
    "internal-ip": "^3.0.1",
    "js-yaml": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "koa": "^2.5.1",
    "koa-bodyparser": "^4.4.1",
    "koa-compress": "^2.0.0",
    "koa-convert": "^1.2.0",
    "koa-helmet": "^4.0.0",
    "koa-json": "^2.0.2",
    "koa-limit": "^1.0.2",
