{
  "name": "tars-web",
  "version": "3.0.15",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/www",
    "startc": "./node_modules/.bin/nodemon bin/www",
    "local": "cross-env NODE_ENV=local ./node_modules/.bin/nodemon bin/www",
    "remote": "cross-env NODE_ENV=remote ./node_modules/.bin/nodemon bin/www",
    "dev": "cross-env NODE_ENV=dev ./node_modules/.bin/nodemon bin/www",
    "k8s": "cross-env NODE_ENV=k8s ./node_modules/.bin/nodemon bin/www",
    "all": "cross-env NODE_ENV=all ./node_modules/.bin/nodemon bin/www",
    "kdev": "cross-env NODE_ENV=kdev ./node_modules/.bin/nodemon bin/www",
    "prd": "pm2 start bin/www --name=tars-node-web",
    "smcicc:inventory": "node tools/smcicc-inventory.js",
    "test:smcicc": "node --test tools/smc-contract-shapes.test.js",
    "db:migrate-smcicc-to-smcicc": "powershell -ExecutionPolicy Bypass -File scripts/migrate-mysql-smcicc-to-smcicc.ps1",
    "test:release": "node --test tools/smc-contract-shapes.test.js tools/release-runtime-dependencies.test.js tools/release-token-key.test.js tools/release-ssh.test.js tools/release-logger.test.js"
  },
